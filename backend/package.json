    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ip-address": "^9.0.5",
    "jimp": "^0.22.12",
    "jsqr": "^1.4.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
