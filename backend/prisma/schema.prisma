// QRGuard Prisma Schema — SQLite dev mode

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("USER")    // USER | MODERATOR | ADMIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  qrSubmissions    QrSubmission[]
  urlAnalyses      UrlAnalysis[]
  communityReports CommunityReport[]
  auditLogs        AuditLog[]
  securityTestRuns SecurityTestRun[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  sid       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isValid   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sid])
  @@index([expiresAt])
}

// ─── QR / URL Analysis ───────────────────────────────────────────────────────

model QrSubmission {
  id           String   @id @default(uuid())
  userId       String?
  fileUploadId String?
  payloadType  String
  payload      String
  analysisId   String?
  createdAt    DateTime @default(now())

  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  upload   FileUpload?  @relation(fields: [fileUploadId], references: [id])
  analysis UrlAnalysis? @relation(fields: [analysisId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([payloadType])
}

model UrlAnalysis {
  id            String   @id @default(uuid())
  userId        String?
  sessionRef    String?
  url           String
  domain        String
  scheme        String
  port          Int?
  riskScore     Int      @default(0)
  riskLevel     String   @default("LOW")    // LOW | MEDIUM | HIGH | CRITICAL
  redirectCount Int      @default(0)
  indicators    String   @default("[]")     // JSON array stored as text
  status        String   @default("PENDING") // PENDING | COMPLETED | FAILED | BLOCKED
  aiSummary     String?
  aiRiskExplain String?
  aiRecommend   String?
  aiConfidence  Float?
  ssrfBlocked   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  redirects      RedirectObservation[]
  riskAssessment RiskAssessment?
  qrSubmissions  QrSubmission[]
  securityEvents SecurityEvent[]

  @@index([userId])
  @@index([domain])
  @@index([riskLevel])
  @@index([createdAt])
  @@index([sessionRef])
}

model Domain {
  id                   String   @id @default(uuid())
  hostname             String   @unique
  firstSeen            DateTime @default(now())
  lastSeen             DateTime @default(now())
  analysisCount        Int      @default(0)
  avgRiskScore         Float    @default(0)
  communityReportCount Int      @default(0)
  riskLevel            String   @default("LOW")
  isKnownSuspicious    Boolean  @default(false)

  communityReports CommunityReport[]

  @@index([hostname])
  @@index([riskLevel])
  @@index([lastSeen])
  @@index([communityReportCount])
}

model RedirectObservation {
  id          String   @id @default(uuid())
  analysisId  String
  fromUrl     String
  toUrl       String
  toDomain    String?
  position    Int
  wasBlocked  Boolean  @default(false)
  blockReason String?
  createdAt   DateTime @default(now())

  analysis UrlAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([toDomain])
}

// ─── Community Intelligence ───────────────────────────────────────────────────

model CommunityReport {
  id           String   @id @default(uuid())
  userId       String
  domainId     String?
  targetUrl    String
  targetDomain String
  category     String
  description  String?
  status       String   @default("PENDING")
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain? @relation(fields: [domainId], references: [id])

  @@index([userId])
  @@index([targetDomain])
  @@index([status])
  @@index([createdAt])
  @@index([category])
}

// ─── Security & Risk ─────────────────────────────────────────────────────────

model SecurityEvent {
  id            String   @id @default(uuid())
  type          String
  severity      String   // LOW | MEDIUM | HIGH | CRITICAL
  userId        String?
  sessionRef    String?
  endpoint      String?
  method        String?
  safeTarget    String?
  action        String
  riskContrib   Int      @default(0)
  prevRiskScore Int?
  newRiskScore  Int?
  analysisId    String?
  metadata      String?  // JSON as text
  createdAt     DateTime @default(now())

  analysis UrlAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
  @@index([sessionRef])
}

model RiskAssessment {
  id         String   @id @default(uuid())
  analysisId String   @unique
  baseScore  Int
  finalScore Int
  factors    String   // JSON as text
  createdAt  DateTime @default(now())

  analysis UrlAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

// ─── Threat Graph ─────────────────────────────────────────────────────────────

model ThreatRelation {
  id           String   @id @default(uuid())
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  metadata     String?  // JSON as text
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationType])
  @@index([createdAt])
}

// ─── Audit & Logging ─────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ipRef      String?
  metadata   String?  // JSON as text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resource, resourceId])
}

// ─── Security Testing ─────────────────────────────────────────────────────────

model SecurityTestRun {
  id              String   @id @default(uuid())
  adminId         String
  testType        String
  testName        String
  purpose         String
  expectedResult  String
  actualResult    String
  securityControl String
  passed          Boolean
  eventGenerated  String?
  riskChange      Int      @default(0)
  duration        Int?
  createdAt       DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([testType])
  @@index([passed])
  @@index([createdAt])
}

// ─── File Upload ──────────────────────────────────────────────────────────────

model FileUpload {
  id            String   @id @default(uuid())
  userId        String?
  storedName    String   @unique
  mimeType      String
  sizeBytes     Int
  isValid       Boolean  @default(false)
  validationMsg String?
  createdAt     DateTime @default(now())

  qrSubmissions QrSubmission[]

  @@index([userId])
  @@index([createdAt])
}

// ─── System Configuration ─────────────────────────────────────────────────────

model SystemConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
